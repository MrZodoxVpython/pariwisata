# ---------------------------------------------------------------------------
# Database (Supabase PostgreSQL)
# ---------------------------------------------------------------------------
# Direct connection (IPv6 only). Format:
# postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
#
# Use the Supavisor pooler when your host/network has no IPv6 route.
# Supabase dashboard → Project Settings → Database → Connection pooling.
# Username format: postgres.PROJECT_REF
DATABASE_URL=postgresql://postgres.genqdhimsibslhekxkja:pariwisata123@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres

# Direct connection equivalent (only works on IPv6-capable networks):
# DATABASE_URL=postgresql://postgres:pariwisata123@db.genqdhimsibslhekxkja.supabase.co:5432/postgres

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Protects GET /api/bookings, PATCH /api/bookings/:id, GET /api/contact
# (legacy; the admin panel uses JWT sign-in below)
ADMIN_TOKEN=change-me-to-a-long-random-string

PG_POOL_MAX=10

# ---------------------------------------------------------------------------
# Admin panel
# ---------------------------------------------------------------------------
# Long random string (min 16 chars). Signs the 8-hour admin session tokens.
ADMIN_JWT_SECRET=change-me-to-a-long-random-string
# Used once by `npm run db:setup` to create the first owner account.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me-8-chars-min
ADMIN_NAME=Owner

# ---------------------------------------------------------------------------
# Media uploads (Supabase Storage, bucket must exist and be public-read)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media

# ---------------------------------------------------------------------------
# Notifications (optional — leave blank to skip)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
MAIL_FROM=Canyoning Bali <hello@example.com>
FONNTE_TOKEN=
CRON_SECRET=change-me-to-a-long-random-string