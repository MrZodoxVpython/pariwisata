# ---------------------------------------------------------------------------
# Database (Supabase PostgreSQL)
# ---------------------------------------------------------------------------
# Direct connection (IPv6 only). Format:
# postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
#
# Use the Supavisor pooler when your host/network has no IPv6 route.
# Supabase dashboard → Project Settings → Database → Connection pooling.
# Username format: postgres.PROJECT_REF
DATABASE_URL=postgresql://postgres.genqdhimsibslhekxkja:pariwisata123@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres

# Direct connection equivalent (only works on IPv6-capable networks):
# DATABASE_URL=postgresql://postgres:pariwisata123@db.genqdhimsibslhekxkja.supabase.co:5432/postgres

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Protects GET /api/bookings, PATCH /api/bookings/:id, GET /api/contact
ADMIN_TOKEN=change-me-to-a-long-random-string

PG_POOL_MAX=10