{
  "name": "canyoning-bali-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Node.js/Express API for Canyoning Bali backed by Supabase PostgreSQL",
  "scripts": {
    "dev": "node --watch index.js",
    "start": "node index.js",
    "db:setup": "node db/setup.js",
    "db:migrate": "node db/migrate.js",
    "db:seed": "node db/setup.js --force"
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "sanitize-html": "2.17.1"
  }
}
